function renderPost(id,p,parent){const el=document.createElement("article");el.className="post";el.innerHTML=`<div class="post-head"><div class="avatar">${esc((p.nickname||"M")[0].toUpperCase())}</div><div><b>${esc(p.nickname)}</b><br><small class="muted">${esc(p.role||"")} · ${p.createdAt?.toDate?.().toLocaleString("tr-TR")||"şimdi"}</small></div></div><p>${esc(p.text||"")}</p>${p.audioUrl?`<audio controls src="${esc(p.audioUrl)}"></audio>`:""}${p.imageUrl?`<img src="${esc(p.imageUrl)}" style="width:100%;border-radius:12px;margin-top:10px">`:""}<div class="actions"><button class="action" data-like>❤️ ${p.likes?.length||0}</button><button class="action" data-delete>Sil</button></div>`;el.querySelector("[data-like]").onclick=async()=>{const liked=(p.likes||[]).includes(current.uid);await updateDoc(doc(db,"posts",id),{likes:liked?arrayRemove(current.uid):arrayUnion(current.uid)})};el.querySelector("[data-delete]").onclick=async()=>{if(p.uid===current.uid&&confirm("Paylaşımı sil?"))await deleteDoc(doc(db,"posts",id))};parent.appendChild(el)}
function loadMyPosts(){listen("mine",query(collection(db,"posts"),orderBy("createdAt","desc"),limit(50)),s=>{$("myPosts").innerHTML="";s.forEach(x=>{if(x.data().uid===current.uid)renderPost(x.id,x.data(),$("myPosts"))})})}

function loadUsers(){listen("users",query(collection(db,"users"),limit(50)),s=>{$("exploreGrid").innerHTML="";$("userList").innerHTML="";s.forEach(x=>{const u=x.data();if(u.uid===current.uid)return;const card=document.createElement("div");card.className="card";card.innerHTML=`<h3>🎵 ${esc(u.nickname)}</h3><p class="muted">${esc(u.role)}</p><button class="action">Mesaj gönder</button>`;card.querySelector("button").onclick=()=>{selectedUser=u;showPage("messages");$("chatTop").textContent=u.nickname;listenMessages()};$("exploreGrid").appendChild(card);const row=document.createElement("div");row.className="userRow";row.innerHTML=`<b>${esc(u.nickname)}</b><br><small class="muted">${esc(u.role)}</small>`;row.onclick=()=>{selectedUser=u;$("chatTop").textContent=u.nickname;listenMessages()};$("userList").appendChild(row)})})}

function convoId(a,b){return[a,b].sort().join("_")}
function listenMessages(){if(!selectedUser)return;const q=query(collection(db,"conversations",convoId(current.uid,selectedUser.uid),"messages"),orderBy("createdAt","asc"),limit(100));listen("chat",q,s=>{$("chatBody").innerHTML="";s.forEach(x=>{const m=x.data();const d=document.createElement("div");d.className="bubble"+(m.uid===current.uid?" mine":"");d.textContent=m.text;$("chatBody").appendChild(d)});$("chatBody").scrollTop=$("chatBody").scrollHeight})}
window.sendMsg=async()=>{const text=$("msgInput").value.trim();if(!text||!selectedUser)return;await addDoc(collection(db,"conversations",convoId(current.uid,selectedUser.uid),"messages"),{uid:current.uid,text,createdAt:serverTimestamp()});$("msgInput").value=""};

window.openPublish=type=>{ $("menu").classList.add("hidden");$("modalBg").classList.remove("hidden");$("modalTitle").textContent=type==="song"?"🎵 Şarkı yayınla":type==="short"?"📱 Short yayınla":"💬 Topluluk mesajı";$("modalContent").innerHTML= type==="post"?`<textarea id="postText" placeholder="Ne düşünüyorsun?"></textarea><button class="primary" onclick="publishPost()">Paylaş</button>`:type==="song"?`<input id="songName" class="input" placeholder="Şarkı adı"><textarea id="songDesc" placeholder="Açıklama"></textarea><label class="file">MP3/WAV<input id="songFile" type="file" accept=".mp3,.wav,audio/mpeg,audio/wav"></label><label class="file">JPG/PNG<input id="songImg" type="file" accept="image/jpeg,image/png"></label><button class="primary" onclick="publishSong()">Yükle ve yayınla</button><p id="uploadStatus" class="muted"></p>`:`<label class="file">MP4/WebM video<input id="shortFile" type="file" accept="video/mp4,video/webm,video/*"></label><textarea id="shortDesc" placeholder="Açıklama"></textarea><button class="primary" onclick="publishShort()">Yükle ve yayınla</button><p id="uploadStatus" class="muted"></p>`};
window.closeModal=()=>{$("modalBg").classList.add("hidden")};

async function upload(file,path){return new Promise((resolve,reject)=>{const task=uploadBytesResumable(ref(storage,path),file);task.on("state_changed",s=>$("uploadStatus").textContent=`Yükleniyor: ${Math.round(s.bytesTransferred/s.totalBytes*100)}%`,reject,async()=>resolve(await getDownloadURL(task.snapshot.ref)))})}
window.publishPost=async()=>{const text=$("postText").value.trim();if(!text)return toast("Mesaj yaz.");const d=await getDoc(doc(db,"users",current.uid));await addDoc(collection(db,"posts"),{uid:current.uid,nickname:d.data().nickname,role:d.data().role,text,likes:[],createdAt:serverTimestamp()});closeModal();toast("Paylaşıldı")};
window.publishSong=async()=>{const name=$("songName").value.trim(),f=$("songFile").files[0],img=$("songImg").files[0];if(!name||!f)return toast("Şarkı adı ve ses dosyası gerekli.");if(!["audio/mpeg","audio/wav","audio/x-wav"].includes(f.type)&&!/\.(mp3|wav)$/i.test(f.name))return toast("Sadece MP3/WAV.");const d=(await getDoc(doc(db,"users",current.uid))).data();const audio=await upload(f,`songs/${current.uid}/${crypto.randomUUID()}-${f.name}`);let imageUrl="";if(img)imageUrl=await upload(img,`images/${current.uid}/${crypto.randomUUID()}-${img.name}`);await addDoc(collection(db,"posts"),{uid:current.uid,nickname:d.nickname,role:d.role,text:`🎵 ${name}${$("songDesc").value.trim()?" — "+$("songDesc").value.trim():""}`,audioUrl:audio,imageUrl,likes:[],createdAt:serverTimestamp()});closeModal();toast("Şarkı yayınlandı")};
window.publishShort=async()=>{const f=$("shortFile").files[0];if(!f)return toast("Video seç.");if(f.size>150*1024*1024)return toast("Video 150 MB'dan küçük olmalı.");const d=(await getDoc(doc(db,"users",current.uid))).data();const url=await upload(f,`shorts/${current.uid}/${crypto.randomUUID()}-${f.name}`);await addDoc(collection(db,"shorts"),{uid:current.uid,nickname:d.nickname,role:d.role,description:$("shortDesc").value.trim(),videoUrl:url,createdAt:serverTimestamp()});closeModal();toast("Short yayınlandı")};
function loadShorts(){listen("shorts",query(collection(db,"shorts"),orderBy("createdAt","desc"),limit(30)),s=>{$("shortGrid").innerHTML="";s.forEach(x=>{const p=x.data(),d=document.createElement("div");d.className="shortCard";d.innerHTML=`<video controls playsinline preload="metadata" src="${esc(p.videoUrl)}"></video><b>${esc(p.nickname)}</b><p class="muted">${esc(p.description||"")}</p>`;$("shortGrid").appendChild(d)})})}
