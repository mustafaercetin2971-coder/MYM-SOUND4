  appId:"YOUR_APP_ID"
};

const app=initializeApp(firebaseConfig),auth=getAuth(app),db=getFirestore(app),storage=getStorage(app);
let current=null,role="REPÇİ",authMode="register",selectedUser=null,unsubs=[];

const $=id=>document.getElementById(id);
const esc=s=>String(s??"").replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[m]));
function toast(t){$("toast").textContent=t;$("toast").classList.remove("hidden");setTimeout(()=>$("toast").classList.add("hidden"),2600)}
window.setAuthMode=m=>{authMode=m;$("registerFields").classList.toggle("hidden",m==="login");$("authButton").textContent=m==="register"?"Kayıt Ol":"Giriş Yap";$("tabRegister").classList.toggle("primary",m==="register");$("tabLogin").classList.toggle("primary",m==="login")};
window.pickRole=(el,r)=>{document.querySelectorAll(".role").forEach(x=>x.classList.remove("selected"));el.classList.add("selected");role=r};
window.submitAuth=async()=>{try{const email=$("email").value.trim(),pass=$("password").value;if(!email||pass.length<6)throw Error("E-posta ve en az 6 karakterlik şifre gerekli.");if(authMode==="register"){const nick=$("nickname").value.trim();if(!nick||!role)throw Error("Mahlas ve meslek seç.");const c=await createUserWithEmailAndPassword(auth,email,pass);await updateProfile(c.user,{displayName:nick});await setDoc(doc(db,"users",c.user.uid),{uid:c.user.uid,nickname:nick,role,email,createdAt:serverTimestamp(),blocked:[]});}else await signInWithEmailAndPassword(auth,email,pass)}catch(e){$("authMsg").textContent=e.message.replace("Firebase: ","")}};

onAuthStateChanged(auth,async u=>{if(!u){$("auth").classList.remove("hidden");$("app").classList.add("hidden");return}current=u;const snap=await getDoc(doc(db,"users",u.uid));const d=snap.exists()?snap.data():{nickname:u.displayName||"Kullanıcı",role:"REPÇİ"};role=d.role||"REPÇİ";$("auth").classList.add("hidden");$("app").classList.remove("hidden");$("miniUser").textContent=d.nickname;$("welcome").textContent=`Hoş geldin ${d.nickname}. ${role} alanındasın.`;$("profileName").textContent=d.nickname;$("profileRole").textContent=role;$("profileEmail").textContent=u.email;$("bigAvatar").textContent=(d.nickname||"M")[0].toUpperCase();loadFeed();loadUsers();loadShorts();loadMyPosts()});

