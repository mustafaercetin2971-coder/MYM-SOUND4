window.setColor=c=>{document.documentElement.style.setProperty("--main",c);document.documentElement.style.setProperty("--main2",c);localStorage.setItem("mymsoundColor",c)};
const savedColor=localStorage.getItem("mymsoundColor");if(savedColor)window.setColor(savedColor);
</script>
</body>
</html>'''

